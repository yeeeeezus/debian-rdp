#!/bin/bash
# ============================================================================
# rdp-keepalive: TOP-LEVEL watchdog - keeps the desktop server alive
# 'all the time' while the sandbox lives.
#
#   Layer 0 (this)  : revives the supervisor if IT dies
#   Layer 1 (sup.)  : revives Xvnc / GNOME session / websockify / save-daemon
#   Layer 2 (repos) : if the whole sandbox resets, bootstrap.sh rebuilds all
#
# Every 30s:
#   - supervisor process dead                      -> relaunch it
#   - ports 5901/3000 dead 3 checks in a row
#     despite a live supervisor (wedged)           -> restart the supervisor
#   - heartbeat logged every 20 loops (10 min)
# Launched double-forked (setsid nohup) so it survives tool-shell cleanup.
# ============================================================================
set -u
BASE=/home/z/debian
RUN=$BASE/run
LOG=$RUN/keepalive.log
INTERVAL=30
mkdir -p "$RUN" 2>/dev/null

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

# single instance guard
LOCK=$RUN/keepalive.pid
if [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK" 2>/dev/null)" 2>/dev/null; then
  exit 0  # already running
fi
echo $$ > "$LOCK"
trap 'rm -f "$LOCK"' EXIT INT TERM

supervisor_up()   { pgrep -f "debian-supervisor" >/dev/null 2>&1; }
vnc_listening()   { ss -ltn 2>/dev/null | grep -q ':5901'; }
web_listening()   { curl -s -o /dev/null --max-time 5 http://127.0.0.1:3000/ 2>/dev/null; }

# RFB handshake probe: the port can be open while VNC refuses/hangs every
# client (e.g. TigerVNC blacklist). Only a real "RFB 003.008" greeting
# proves the desktop is actually reachable. Pure bash, no extra tools.
vnc_serving() {
  timeout 3 bash -c 'exec 3<>/dev/tcp/127.0.0.1/5901 && head -c 4 <&3' 2>/dev/null \
    | grep -q 'RFB'
}

launch_supervisor() {
  # exact same double-fork pattern as debian-start
  ( setsid nohup "$BASE/bin/debian-supervisor" >> "$RUN/supervisor.out" 2>&1 < /dev/null & )
  log "ACTION: supervisor relaunched"
}

log "keepalive up (pid $$, checking every ${INTERVAL}s)"

STRIKES=0
LOOPS=0
while true; do
  # 1. supervisor process alive?
  if ! supervisor_up; then
    launch_supervisor
    sleep 10
  fi

  # 2. are the service ports actually serving? (RFB probe, not just open)
  if vnc_serving && web_listening; then
    STRIKES=0
  else
    STRIKES=$((STRIKES + 1))
    log "WARN: not serving (vnc=$(vnc_serving && echo up || echo DOWN) web=$(web_listening && echo up || echo DOWN)) strike $STRIKES/3"
    if [ $STRIKES -ge 3 ]; then
      if supervisor_up; then
        log "ACTION: supervisor wedged - killing + restarting it"
        pkill -9 -f "debian-supervisor" 2>/dev/null
        sleep 3
      fi
      launch_supervisor
      sleep 20
      STRIKES=0
    fi
  fi

  LOOPS=$((LOOPS + 1))
  if [ $((LOOPS % 20)) -eq 0 ]; then
    log "heartbeat: all layers running (vnc=$(vnc_serving && echo up || echo DOWN) web=$(web_listening && echo up || echo DOWN) supervisor=$(supervisor_up && echo up || echo DOWN))"
  fi

  sleep $INTERVAL
done
