#!/bin/bash
# ============================================================================
# debian-supervisor: watchdog for the Debian 13 GNOME desktop.
# Keeps alive:
#   1. Xtigervnc :1  (VNC on localhost:5901)          [fakechroot]
#   2. GNOME 48 session on :1                        [fakechroot]
#   3. websockify backend on 127.0.0.1:3001          [fakechroot]
#   4. front-proxy on 0.0.0.0:3000                   [HOST python]
#      - file bridge (/fapi upload-list-download)
#      - byte-transparent WS/static proxy -> :3001
#   5. rdp-save daemon (continuous GitHub backup)
# Auto-restarts any component that dies. If front-proxy crash-loops the
# supervisor FALLS BACK to plain websockify on :3000 so the desktop stays
# reachable (file bridge offline in that mode).
# Before restarting the session it
# SWEEPS the whole leftover tree (prevents WM-selection races, dbus zombies
# and process exhaustion that crash-looping sessions used to cause).
# Launched by debian-start.
# ============================================================================
set -u
BASE=/home/z/debian
S=$BASE/sysroot
RUN=$BASE/run
GEOMETRY="${GEOMETRY:-1600x900}"
mkdir -p "$RUN"

export LD_LIBRARY_PATH="$S/usr/lib/x86_64-linux-gnu:$S/lib/x86_64-linux-gnu"
export LD_PRELOAD="$S/usr/lib/x86_64-linux-gnu/fakechroot/libfakechroot.so"
export FAKECHROOT_EXCLUDE_PATH="/dev:/proc:/sys:/tmp"
export DISPLAY_NUM=1
CHROOT=/usr/sbin/chroot
[ -x "$CHROOT" ] || CHROOT=/usr/bin/chroot

VNC_LOG=$RUN/xvnc.log
SESS_LOG=$RUN/session.log
WS_LOG=$RUN/websockify.log

pid_alive() {  # pid_alive <pidfile>
  [ -f "$1" ] && kill -0 "$(cat "$1" 2>/dev/null)" 2>/dev/null
}

log() { echo "$(date '+%F %T') $*" >> "$RUN/supervisor.log"; }

# kill every process of a dead session tree so nothing orphans
sweep_session_tree() {
  local pats=(
    '/usr/local/bin/session-inner' 'gnome-session-binary' '/usr/bin/gnome-shell'
    'dbus-run-session' 'gnome-session-failed' 'gsd-' 'gnome-keyring'
    'mutter' 'xdg-desktop' 'gvfsd' 'evolution' 'goa-daemon' 'at-spi'
    'localsearch' 'dconf-service' 'gnome-shell-calendar' 'gnome-software'
    'accounts-daemon' 'colord' 'upowerd'
  )
  for p in "${pats[@]}"; do pkill -9 -f "$p" 2>/dev/null; done
  # session + system dbus of the fakechroot system
  pkill -9 -f '/usr/bin/dbus-daemon' 2>/dev/null
  pkill -9 -f 'dbus-daemon --system' 2>/dev/null
  sleep 1
}

start_vnc() {
  # we own every Xvnc in this container: kill untracked leftovers so the
  # new instance can bind :5901 (an orphan holding the port = restart loop)
  pkill -9 -f 'Xtigervnc' 2>/dev/null
  sleep 1
  rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 2>/dev/null
  cp /etc/resolv.conf "$S/etc/resolv.conf" 2>/dev/null || true
  "$CHROOT" "$S" /usr/bin/Xtigervnc :1 \
    -pn -localhost -ac \
    -rfbauth /home/debian/.vnc/passwd \
    -BlacklistThreshold 999999999 -BlacklistTimeout 1 \
    -geometry "$GEOMETRY" -depth 24 -dpi 96 \
    >> "$VNC_LOG" 2>&1 &
  echo $! > "$RUN/xvnc.pid"
  log "started Xtigervnc :1 pid $(cat "$RUN/xvnc.pid") geometry=$GEOMETRY"
}

start_session() {
  sweep_session_tree
  cp /etc/resolv.conf "$S/etc/resolv.conf" 2>/dev/null || true
  "$CHROOT" "$S" /usr/local/bin/session-inner >> "$SESS_LOG" 2>&1 &
  echo $! > "$RUN/session.pid"
  log "started GNOME session pid $(cat "$RUN/session.pid")"
}

start_ws() {
  # same ownership rule for websockify: clear the port before binding.
  # websockify is now the BACKEND on 127.0.0.1:3001 - front-proxy fronts
  # it on :3000 (see start_front). In FALLBACK mode it binds :3000 itself.
  pkill -9 -f 'websockify' 2>/dev/null
  sleep 1
  if [ "${FALLBACK:-0}" = "1" ]; then
    "$CHROOT" "$S" /usr/bin/websockify --web=/usr/share/novnc \
      0.0.0.0:3000 127.0.0.1:5901 >> "$WS_LOG" 2>&1 &
  else
    "$CHROOT" "$S" /usr/bin/websockify --web=/usr/share/novnc \
      127.0.0.1:3001 127.0.0.1:5901 >> "$WS_LOG" 2>&1 &
  fi
  echo $! > "$RUN/ws.pid"
  log "started websockify pid $(cat "$RUN/ws.pid") (${FALLBACK:-0} = fallback)"
}

start_front() {
  # front-proxy owns :3000: /fapi file bridge + transparent proxy to the
  # websockify backend on :3001. Runs on HOST python (no chroot needed).
  if [ "${FALLBACK:-0}" = "1" ]; then
    log "front-proxy disabled (fallback mode)"
    return
  fi
  if pid_alive "$RUN/front.pid"; then return; fi
  pkill -9 -f 'bin/front-proxy' 2>/dev/null
  /home/z/debian/bin/front-proxy >> "$RUN/front-proxy.log" 2>&1 &
  echo $! > "$RUN/front.pid"
  log "started front-proxy pid $(cat "$RUN/front.pid")"
}

start_save() {
  if [ -x "$BASE/bin/rdp-save-daemon" ] && ! pgrep -f rdp-save-daemon >/dev/null 2>&1; then
    ( setsid nohup "$BASE/bin/rdp-save-daemon" >> "$RUN/rdp-save.log" 2>&1 < /dev/null & )
    log "started rdp-save daemon"
  fi
}

# clean stale pidfiles from a previous run
for f in xvnc session ws front; do
  pid_alive "$RUN/$f.pid" || rm -f "$RUN/$f.pid"
done

FRONT_FAILS=0
FRONT_STUCK=0
FALLBACK=0
port3000() { timeout 1 bash -c 'echo > /dev/tcp/127.0.0.1/3000' 2>/dev/null; }

log "supervisor up (geometry=$GEOMETRY, GNOME)"

while true; do
  # 1. X server (session depends on it - start after)
  if ! pid_alive "$RUN/xvnc.pid"; then
    sweep_session_tree
    start_vnc
    sleep 3
    start_session
  fi
  # 2. GNOME session (X up but session died -> clean restart)
  if pid_alive "$RUN/xvnc.pid" && ! pid_alive "$RUN/session.pid"; then
    start_session
  fi
  # 3. websockify backend / noVNC web client
  if ! pid_alive "$RUN/ws.pid"; then
    start_ws
  fi
  # 3a. front-proxy (file bridge + :3000 ingress)
  if ! pid_alive "$RUN/front.pid"; then
    if [ "$FALLBACK" = "1" ]; then
      :   # fallback: websockify already owns :3000
    else
      start_front
      FRONT_FAILS=$((FRONT_FAILS + 1))
      FRONT_STUCK=0
      if [ "$FRONT_FAILS" -ge 3 ]; then
        FALLBACK=1
        log "front-proxy failed ${FRONT_FAILS}x - FALLING BACK to plain websockify on :3000"
        start_ws
      fi
    fi
  else
    # alive but port not answering = wedged: kill + let loop restart it
    if port3000; then
      FRONT_STUCK=0
      FRONT_FAILS=0   # healthy period forgives past failures
    else
      FRONT_STUCK=$((FRONT_STUCK + 1))
      if [ "$FRONT_STUCK" -ge 2 ]; then
        log "front-proxy wedged (pid up, :3000 dead) - recycling"
        kill -9 "$(cat "$RUN/front.pid" 2>/dev/null)" 2>/dev/null
        rm -f "$RUN/front.pid"
      fi
    fi
  fi
  # 3b. websockify handler flood guard: handlers can wedge forever when
  # the VNC side hiccuped (each stuck client = one process). >15 procs
  # with at most a few real tabs open = flood -> recycle the whole tree.
  WSN=$(pgrep -c -f 'websockify' 2>/dev/null || true)
  if [ "${WSN:-0}" -gt 15 ]; then
    log "websockify flood: $WSN procs - recycling"
    start_ws
  fi
  # 4. continuous backup daemon
  start_save
  sleep 5
done
