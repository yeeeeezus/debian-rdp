#!/bin/bash
# Start the Debian 13 KDE Plasma desktop (idempotent).
set -u
BASE=/home/z/debian
RUN=$BASE/run
mkdir -p "$RUN"

if pgrep -f "debian-supervisor" >/dev/null 2>&1; then
  echo "supervisor already running"
else
  # double-fork daemonize: subshell exits instantly, child reparents to init
  # (single '&' is reaped by the tool harness when the shell exits)
  ( setsid nohup "$BASE/bin/debian-supervisor" >> "$RUN/supervisor.out" 2>&1 < /dev/null & )
  sleep 1
  echo "supervisor started"
fi

# top-level keepalive: revives the supervisor if IT ever dies
if [ -x "$BASE/bin/rdp-keepalive" ] && ! pgrep -f "rdp-keepalive" >/dev/null 2>&1; then
  ( setsid nohup "$BASE/bin/rdp-keepalive" >> "$RUN/keepalive.log" 2>&1 < /dev/null & )
  sleep 1
  echo "keepalive started"
fi
sleep 2
exec "$BASE/bin/debian-status"
